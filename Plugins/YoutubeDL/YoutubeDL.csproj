<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-windows</TargetFrameworks>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AssemblyVersion>1.3.1.0</AssemblyVersion>
		<FileVersion>1.3.1.0</FileVersion>
		<RootNamespace>FlyleafLib.Plugins</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="YoutubeDL.Tests" />
		<ProjectReference Include="..\..\FlyleafLib\FlyleafLib.csproj">
			<Private>false</Private>
			<ExcludeAssets>All</ExcludeAssets>
		</ProjectReference>
	</ItemGroup>

	<Target Name="EnsureWebPlaybackTools" BeforeTargets="Build" Condition="'$(TargetFramework)' != '' and '$(DesignTimeBuild)' != 'true'">
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\Get-WebPlaybackTools.ps1&quot;" />
	</Target>

	<Target Name="CopyPluginRuntime" AfterTargets="Build" DependsOnTargets="EnsureWebPlaybackTools" Condition="'$(TargetFramework)' != ''">
		<PropertyGroup>
			<PluginRuntimeDir>$(MSBuildProjectDirectory)\..\bin\Plugins.NET10\YoutubeDL</PluginRuntimeDir>
		</PropertyGroup>
		<ItemGroup>
			<WebPlaybackRuntime Include="$(MSBuildProjectDirectory)\Libs\*" Exclude="$(MSBuildProjectDirectory)\Libs\*.exe_here" />
		</ItemGroup>
		<MakeDir Directories="$(PluginRuntimeDir)" />
		<Copy SourceFiles="$(TargetPath);@(WebPlaybackRuntime)" DestinationFolder="$(PluginRuntimeDir)" SkipUnchangedFiles="true" />
	</Target>

</Project>
