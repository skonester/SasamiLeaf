<Page
    x:Class="SasamiLeaf.Uno.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winui="using:SasamiLeaf.Uno.Controls"
    xmlns:converters="using:SasamiLeaf.Uno.Converters"
    mc:Ignorable="d"
    Background="Black"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Page.Resources>
        <converters:TicksToTimeConverter x:Key="TicksToTime"/>
        <converters:TicksToTimeWithMsConverter x:Key="TicksToTimeWithMs"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrush"/>
        <converters:InvertBooleanConverter x:Key="InvertBoolean"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <converters:StringFormatConverter x:Key="StringFormatConverter"/>
        <converters:PlayerStatusToVisibilityConverter x:Key="PlayerStatusToVisibility"/>
    </Page.Resources>

    <Grid>
        <winui:FullScreenContainer x:Name="MyFSC">
            <winui:FlyleafME x:Name="MyFlyleafME">
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title Bar (Header) -->
                    <Grid Grid.Row="0" x:Name="HeaderGrid" Margin="0" Height="50"
                          Visibility="{Binding IsFullScreen, Converter={StaticResource BooleanToVisibility}, ConverterParameter=inverse}">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#000080" Offset="0"/>
                                <GradientStop Color="#1084d0" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Image Source="ms-appx:///Assets/Flyleaf.ico" Stretch="Uniform" Height="30" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   Text="SasamiLeaf" FontSize="18" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                            <ToggleButton Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding DetachedTopMost, Mode=TwoWay}" ToolTipService.ToolTip="Always on Top">
                                <SymbolIcon Symbol="Pin" Foreground="White"/>
                            </ToggleButton>
                            <Button Background="Transparent" BorderThickness="0" Click="BtnMinimize_Click" ToolTipService.ToolTip="Minimize">
                                <SymbolIcon Symbol="Minimize" Foreground="White"/>
                            </Button>
                            <ToggleButton Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsFullScreen, Mode=TwoWay}" ToolTipService.ToolTip="Fullscreen">
                                <SymbolIcon Symbol="FullScreen" Foreground="White"/>
                            </ToggleButton>
                            <Button Background="Transparent" BorderThickness="0" Click="BtnClose_Click" ToolTipService.ToolTip="Close">
                                <SymbolIcon Symbol="Close" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" x:Name="PART_ContextMenuOwner">
                        <Grid>
                            <Image Source="ms-appx:///Images/background.bmp" Stretch="UniformToFill"
                                   Visibility="{Binding Player.Status, Converter={StaticResource PlayerStatusToVisibility}}"/>
                        </Grid>
                    </Grid>
                    <FontIcon x:Name="SlidePlayIcon" Glyph="&#xF5B0;" Foreground="White" Visibility="Collapsed"/>
                </Grid>
            </winui:FlyleafME>
        </winui:FullScreenContainer>
    </Grid>
</Page>
