<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.26100</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>SasamiLeaf.Uno</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.sasamileaf-uno</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>SasamiLeaf.Uno</ApplicationPublisher>
    <!-- Package Description -->
    <Description>SasamiLeaf.Uno powered by Uno Platform.</Description>
    <!--
      If you encounter this error message:

        error NETSDK1148: A referenced assembly was compiled using a newer version of Microsoft.Windows.SDK.NET.dll.
        Please update to a newer .NET SDK in order to reference this assembly.

      This means that the two packages below must be aligned with the "build" version number of
      the "Microsoft.Windows.SDK.BuildTools" package above, and the "revision" version number
      must be the highest found in https://www.nuget.org/packages/Microsoft.Windows.SDK.NET.Ref.
    -->
    <!-- <WindowsSdkPackageVersion>10.0.22621.28</WindowsSdkPackageVersion> -->

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Material;
      Mvvm;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FlyleafLib\FlyleafLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.WinUI" />
  </ItemGroup>

  <Target Name="CopyNativeLibraries" AfterTargets="Build">
    <ItemGroup>
      <FFmpegFiles Include="$(MSBuildProjectDirectory)\..\..\FFmpeg\**\*.*" />
      <PluginFiles Include="$(MSBuildProjectDirectory)\..\..\Plugins\bin\Plugins.NET10\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FFmpegFiles)" DestinationFiles="@(FFmpegFiles->'$(TargetDir)FFmpeg\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFiles="@(PluginFiles->'$(TargetDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PostPublish" AfterTargets="Publish">
    <ItemGroup>
      <FFmpegFilesPublish Include="$(MSBuildProjectDirectory)\..\..\FFmpeg\**\*.*" />
      <PluginFilesPublish Include="$(MSBuildProjectDirectory)\..\..\Plugins\bin\Plugins.NET10\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FFmpegFilesPublish)" DestinationFiles="@(FFmpegFilesPublish->'$(PublishDir)FFmpeg\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PluginFilesPublish)" DestinationFiles="@(PluginFilesPublish->'$(PublishDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
