<UserControl
    x:Class="SasamiLeaf.Uno.Controls.FlyleafBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SasamiLeaf.Uno.Converters"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Bottom">

    <UserControl.Resources>
        <converters:TicksToTimeConverter x:Key="TicksToTime"/>
        <converters:InvertBooleanConverter x:Key="InvertBoolean"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>
    </UserControl.Resources>

    <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
            BorderThickness="0,1,0,0" 
            BorderBrush="{ThemeResource SystemControlElevationBorderBrush}"
            Padding="12,8,12,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Progress Timeline Row -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="{Binding Player.CurTime, Mode=OneWay, Converter={StaticResource TicksToTime}}" 
                           VerticalAlignment="Center" 
                           Style="{ThemeResource CaptionTextBlockStyle}"/>
                
                <Slider Grid.Column="1" 
                        Margin="12,0,12,0" 
                        Value="{Binding Player.CurTime, Mode=TwoWay}" 
                        Maximum="{Binding Player.Duration, Mode=OneWay}" 
                        VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" 
                           Text="{Binding Player.Duration, Mode=OneWay, Converter={StaticResource TicksToTime}}" 
                           VerticalAlignment="Center" 
                           Style="{ThemeResource CaptionTextBlockStyle}"/>
            </Grid>

            <!-- Playback Controls Row -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Play/Pause -->
                    <ColumnDefinition Width="Auto"/> <!-- Playlist Controls -->
                    <ColumnDefinition Width="*"/>    <!-- Text Title / Status -->
                    <ColumnDefinition Width="Auto"/> <!-- Audio / Subtitles Dropdowns -->
                    <ColumnDefinition Width="Auto"/> <!-- Volume Controls -->
                    <ColumnDefinition Width="Auto"/> <!-- Settings -->
                    <ColumnDefinition Width="Auto"/> <!-- Fullscreen -->
                </Grid.ColumnDefinitions>

                <!-- Play/Pause Button -->
                <Button Grid.Column="0" 
                        Command="{Binding Player.Commands.TogglePlayPause}"
                        Padding="8"
                        Background="Transparent"
                        BorderBrush="Transparent">
                    <SymbolIcon Symbol="Play" x:Name="PlayIcon"/>
                </Button>

                <!-- Playlist Prev/Next -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" Spacing="4">
                    <Button Content="&#xE892;" 
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Command="{Binding Player.Commands.Reopen}" 
                            CommandParameter="{Binding Player.Playlist.PrevItem}"
                            Background="Transparent" BorderBrush="Transparent"
                            Visibility="{Binding Player.Playlist.PrevItem, Converter={StaticResource NullToVisibility}, ConverterParameter=inverse}"/>
                    <Button Content="&#xE893;" 
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Command="{Binding Player.Commands.Reopen}" 
                            CommandParameter="{Binding Player.Playlist.NextItem}"
                            Background="Transparent" BorderBrush="Transparent"
                            Visibility="{Binding Player.Playlist.NextItem, Converter={StaticResource NullToVisibility}, ConverterParameter=inverse}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,12,0" Spacing="8">
                    <TextBlock Text="{Binding Player.Playlist.Selected.Title}" 
                               Style="{ThemeResource BodyTextBlockStyle}" 
                               TextTrimming="CharacterEllipsis" 
                               MaxWidth="300"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Audio/Subtitles selectors -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="0,0,12,0">
                    <!-- Subtitles Selector -->
                    <Button Content="&#xED15;" 
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Background="Transparent" BorderBrush="Transparent"
                            ToolTipService.ToolTip="Subtitles">
                        <Button.Flyout>
                            <MenuFlyout x:Name="SubtitlesFlyout"/>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- Volume Controls -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" Margin="0,0,12,0">
                    <Button Command="{Binding Player.Commands.ToggleMute}"
                            Background="Transparent" BorderBrush="Transparent">
                        <SymbolIcon Symbol="Volume" x:Name="VolumeIcon"/>
                    </Button>
                    <Slider Value="{Binding Player.Audio.Volume, Mode=TwoWay}" 
                            Minimum="0" 
                            Maximum="100" 
                            Width="80" 
                            VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Settings -->
                <Button Grid.Column="5" 
                        Command="{Binding OpenSettingsCmd}"
                        Background="Transparent" BorderBrush="Transparent"
                        Margin="0,0,8,0">
                    <SymbolIcon Symbol="Setting"/>
                </Button>

                <!-- Fullscreen Toggle -->
                <ToggleButton Grid.Column="6" 
                              IsChecked="{Binding IsFullScreen, Mode=TwoWay}"
                              Background="Transparent" BorderBrush="Transparent">
                    <SymbolIcon Symbol="FullScreen"/>
                </ToggleButton>
            </Grid>
        </Grid>
    </Border>
</UserControl>
