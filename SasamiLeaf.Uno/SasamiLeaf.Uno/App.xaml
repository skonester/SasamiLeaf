<Application
    x:Class="SasamiLeaf.Uno.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:um="using:Uno.Material">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <um:MaterialTheme ColorOverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom fallback brushes for Fluent styling under Material theme -->
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#E6212121" />
            <SolidColorBrush x:Key="SystemControlElevationBorderBrush" Color="#3C3C3C" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

