<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FlyleafPlayer</RootNamespace>
    <UseWPF>true</UseWPF>
    <AssemblyName>SasamiLeaf</AssemblyName>
    <Version>2.0.2</Version>
    <Version Condition="'$(SasamiLeafVersion)' != ''">$(SasamiLeafVersion)</Version>
    <ApplicationIcon>Flyleaf.ico</ApplicationIcon>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <Copyright>SuRGeoNix © 2025</Copyright>
    <Authors>SuRGeoNix</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Flyleaf.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlyleafLib.Controls.WPF\FlyleafLib.Controls.WPF.csproj" />
    <ProjectReference Include="..\Plugins\YoutubeDL\YoutubeDL.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <_DeploymentManifestIconFile Remove="Flyleaf.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Flyleaf.FFmpeg.Bindings" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Flyleaf.ico" />
    <Resource Include="Images\background.bmp" />
    <Resource Include="Images\menu.bmp" />
  </ItemGroup>

  <Target Name="CopyPlaybackRuntime" AfterTargets="Build">
    <ItemGroup>
      <PluginRuntime Include="$(MSBuildProjectDirectory)\..\Plugins\bin\Plugins.NET10\**\*" />
      <FFmpegRuntime Include="$(MSBuildProjectDirectory)\..\FFmpeg\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginRuntime)" DestinationFiles="@(PluginRuntime->'$(TargetDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FFmpegRuntime)" DestinationFolder="$(TargetDir)FFmpeg" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PostPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedPluginRuntime Include="$(MSBuildProjectDirectory)\..\Plugins\bin\Plugins.NET10\**\*" />
      <PublishedFFmpegRuntime Include="$(MSBuildProjectDirectory)\..\FFmpeg\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedPluginRuntime)" DestinationFiles="@(PublishedPluginRuntime->'$(PublishDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PublishedFFmpegRuntime)" DestinationFolder="$(PublishDir)FFmpeg" SkipUnchangedFiles="true" />
  </Target>

</Project>
